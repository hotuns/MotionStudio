{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "jsxImportSource": "@motion-i18n",
    "baseUrl": ".",
    "paths": {
      "@motion-i18n/*": [
        "src/i18n-runtime/*"
      ]
    }
  },
  "include": [
    "src",
    "vite.config.ts"
  ]
}
